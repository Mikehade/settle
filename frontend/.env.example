# Copy to .env.local to override. Nothing here is required for local development.

# Where the dev server proxies /api (REST and the mediation WebSocket). Read by vite.config.ts only.
BACKEND_URL=http://localhost:8000

# Absolute API origin for a build served apart from the backend, e.g. https://api.example.com.
# Leave empty to call the same origin the app is served from.
VITE_API_URL=
