# development | staging | production | test
APP_ENV=development
APP_NAME=settle

# json | console
LOG_FORMAT=console
LOG_LEVEL=DEBUG

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/settle

# Comma-separated, empty disables CORS
CORS_ORIGINS=

# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_SECONDS=1800

# ---- PayPal (sandbox) ------------------------------------------------------
# From your PayPal developer sandbox app (REST API app with Disputes enabled).
# NEVER commit real values — keep them in .env (gitignored), not here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# ---- AWS Bedrock -----------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=arn:aws:bedrock:us-east-1:779056097161:inference-profile/global.anthropic.claude-opus-4-8
BEDROCK_TEMPERATURE=0.3

# ---- Mediation -------------------------------------------------------------
# false = native LLM + tools (Bedrock Converse); true = LangGraph chain.
MEDIATION_ENGINE_GRAPH=false
# auto = real Disputes API then seeded fixture fallback; paypal = real only; fixture = seeded only.
DISPUTE_SOURCE_MODE=auto
# Guardrail fallbacks (a seller's FairnessPolicy overrides these per case).
GUARDRAIL_CONFIDENCE_THRESHOLD=0.80
GUARDRAIL_HUMAN_IN_LOOP_AMOUNT=200.0
GUARDRAIL_PARTIAL_REFUND_CEILING=150.0
